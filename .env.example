# Copy to .env.local for local development.

# "local" stores data in ./.data (no GCP needed). "firestore" uses Firestore + Cloud Storage.
DATA_BACKEND=local
GOOGLE_CLOUD_PROJECT=amnet-sea
GCS_BUCKET=amnet-sea-ai-builder-companion-photos
FIRESTORE_DATABASE=ai-builder-companion

# Gemini on Vertex AI (uses Application Default Credentials).
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.5-flash
# Optional: use the Gemini Developer API instead of Vertex AI.
# GEMINI_API_KEY=

# Cloud Text-to-Speech voice. Set TTS_DISABLED=1 to fall back to the browser voice.
TTS_VOICE=en-GB-Chirp3-HD-Aoede
TTS_LANGUAGE=en-GB

# Maps Geocoding API key (turns GPS into a town name). Optional.
MAPS_API_KEY=

# Passcode for the carer page. Leave empty to disable the check locally.
CARER_PASSCODE=

# Shared secret Cloud Scheduler sends to /api/reminders/tick.
CRON_SECRET=

# Gemini Live for the photo chat. Run the relay with `npm run relay`; leave LIVE_RELAY_URL empty to use tap-to-talk only.
LIVE_RELAY_URL=ws://localhost:8081
LIVE_RELAY_SECRET=local-dev-relay-secret
# Relay-only settings (read by relay/server.ts).
LIVE_LOCATION=us-central1
LIVE_MODEL=gemini-3.8-live
LIVE_VOICE=Aoede

# Firebase web config, only needed for push notifications (FCM).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
